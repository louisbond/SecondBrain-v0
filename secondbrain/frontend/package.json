{
  "name": "secondbrain-frontend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync:vditor": "node scripts/sync-vditor-assets.mjs",
    "prebuild": "npm run sync:vditor",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
