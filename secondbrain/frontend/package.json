    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "vditor": "^3.8.10",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^5.2.0"
  }
}
